# npm run env:init creates .env from this file and fills in the blank secrets.

# --- Clerk -> Convex: the Issuer URL of your Clerk "convex" JWT template.
CLERK_JWT_ISSUER_DOMAIN=

# --- Convex -> n8n: where Convex sends request events. n8n's port is published to localhost.
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop/request-events

# --- HMAC secrets, one per direction, so a leak or a reflected message in one
# direction cannot be used in the other.
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# --- n8n: encrypts credentials at rest. Changing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=
