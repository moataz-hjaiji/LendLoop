{
  "id": "lendloopOverdue1",
  "name": "LendLoop - Overdue Reminders",
  "active": false,
  "nodes": [
    {
      "id": "note",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        -180
      ],
      "parameters": {
        "content": "## Overdue Reminders\nRuns daily. Fetch, claim, send, write back.\n\nThe claim is what makes re-runs safe: the key is loanId + date, so a re-run or retry cannot remind anyone twice in a day.\n\nThe Manual Trigger is for demos. n8n does not fire the Error Workflow for manual runs.",
        "width": 560,
        "height": 190
      }
    },
    {
      "id": "every-day-08:00-utc",
      "name": "Every Day 08:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        120
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "run-now",
      "name": "Run Now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {}
    },
    {
      "id": "request-overdue-list",
      "name": "Request Overdue List",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        200
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { \"method\": \"GET\", \"path\": \"/n8n/overdue-loans\", \"body\": \"\" } }}",
        "options": {}
      }
    },
    {
      "id": "fetch-overdue",
      "name": "Fetch Overdue",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        680,
        200
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "lendloopSignedReq",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "one-item-per-loan",
      "name": "One Item Per Loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const loans = $input.first().json.response.loans;\nconsole.log(`[overdue] ${loans.length} loan(s) to remind`);\nreturn loans.map((loan) => ({ json: loan }));"
      }
    },
    {
      "id": "build-claim",
      "name": "Build Claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Key is loanId + date, set by Convex: at most one reminder per loan per day, however many times this runs.\nreturn {\n  method: 'POST',\n  path: '/n8n/activity',\n  body: JSON.stringify({ idempotencyKey: $json.idempotencyKey, kind: 'reminder', status: 'sending', loanId: $json.loanId }),\n  context: $json,\n};"
      }
    },
    {
      "id": "claim",
      "name": "Claim",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "lendloopSignedReq",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "won-claim",
      "name": "Won Claim",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.response.applied }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "mock-send-reminder",
      "name": "Mock Send Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const mask = (email) => email.replace(/^(.).*(@.*)$/, '$1***$2');\n\n// Mock reminder: writes to the container log and this execution's output. An address\n// ending in @bounce.test simulates a delivery failure, for demoing the failure path.\nconst loan = $json.context;\nconst delivered = !loan.borrowerEmail.endsWith('@bounce.test');\nconst subject = `Hi ${loan.borrowerFirstName}, ${loan.toolName} was due back ${loan.daysOverdue} day(s) ago`;\n// The address is masked so logs do not accumulate personal data.\nconsole.log(JSON.stringify({ channel: 'mock-reminder', to: mask(loan.borrowerEmail), subject, delivered }));\nreturn {\n  method: 'POST',\n  path: '/n8n/activity',\n  body: JSON.stringify({\n    idempotencyKey: loan.idempotencyKey,\n    kind: 'reminder',\n    status: delivered ? 'sent' : 'failed',\n    loanId: loan.loanId,\n    detail: delivered ? undefined : 'Mock delivery failed',\n  }),\n  context: { idempotencyKey: loan.idempotencyKey, delivered },\n};"
      }
    },
    {
      "id": "write-back",
      "name": "Write Back",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2000,
        120
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "lendloopSignedReq",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "fail-run-if-undelivered",
      "name": "Fail Run If Undelivered",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Runs after every item has been written back, so one bad recipient does not stop the\n// others. Throwing here marks the run failed, which triggers the Error Workflow.\nconst failed = $input.all().filter((item) => item.json.context.delivered === false);\nif (failed.length > 0) {\n  throw new Error(`${failed.length} of ${$input.all().length} reminder(s) failed: ${failed.map((item) => item.json.context.idempotencyKey).join(', ')}`);\n}\nreturn [{ json: { sent: $input.all().length } }];"
      }
    }
  ],
  "connections": {
    "Every Day 08:00 UTC": {
      "main": [
        [
          {
            "node": "Request Overdue List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Now": {
      "main": [
        [
          {
            "node": "Request Overdue List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Overdue List": {
      "main": [
        [
          {
            "node": "Fetch Overdue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Overdue": {
      "main": [
        [
          {
            "node": "One Item Per Loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One Item Per Loan": {
      "main": [
        [
          {
            "node": "Build Claim",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Claim": {
      "main": [
        [
          {
            "node": "Claim",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim": {
      "main": [
        [
          {
            "node": "Won Claim",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Won Claim": {
      "main": [
        [
          {
            "node": "Mock Send Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mock Send Reminder": {
      "main": [
        [
          {
            "node": "Write Back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write Back": {
      "main": [
        [
          {
            "node": "Fail Run If Undelivered",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "lendloopErrorWf1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "tags": []
}
